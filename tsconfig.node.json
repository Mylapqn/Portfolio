{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["studio/**/*.ts", "build.ts", "shared/**/*.ts"]
}
